{
  "name": "pi-subagents-lite",
  "version": "1.17.1",
  "packageManager": "npm@11.9.0",
  "description": "Lightweight sub-agents for pi — spawn specialized agents with isolated sessions, tools, and models.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "subagents",
    "ai",
    "agents"
  ],
  "author": "AlexParamonov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexParamonov/pi-subagents-lite.git"
  },
  "homepage": "https://github.com/AlexParamonov/pi-subagents-lite#readme",
  "bugs": {
    "url": "https://github.com/AlexParamonov/pi-subagents-lite/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.82.0",
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.82.0",
    "typebox": ">=1.3.7"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "vp check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "test": "vp test run"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  }
}
